


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicLevel {
  BACHELOR
  MASTER
  PHD
}

enum RegistrationStatus {
  PENDING_APPROVAL
  REJECTED
  ACTIVE
}

enum VisaStatus {
  ACTIVE
  EXPIRED
  PENDING
  CANCELLED
}

enum RequestStatus {
  PENDING
  FORWARDED_TO_ADVISOR
  ADVISOR_APPROVED
  ADVISOR_REJECTED
  STAFF_APPROVED
  STAFF_REJECTED
  FORWARDED_TO_DEAN
  DEAN_APPROVED
  DEAN_REJECTED
  CANCELLED
}

enum DocumentType {
  PASSPORT_COPY
  VISA_COPY
  TRANSCRIPT
  INSURANCE
  ENROLLMENT_CERTIFICATE
  PHOTO
  WORK_PERMIT
  OTHER
}

enum InterserviceStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  VISA_ALERT
  REGISTRATION
  REQUEST_UPDATE
  DOCUMENT_REQUIRED
  GENERAL
}

// ─────────────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  name      String
  phone     String?
  image     String?
  role      String?  // legacy field — ใช้ระหว่าง migration เท่านั้น จะ drop หลัง migrate เสร็จ
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student                  Student?
  advisor                  Advisor?
  auditLogs                AuditLog[]
  notifications            Notification[]
  userRoles                UserRole[]
  deanDelegationAsDean     DeanDelegation?  @relation("DeanDelegation_dean")
  deanDelegationAsDelegate DeanDelegation[] @relation("DeanDelegation_delegate")
  changeRequestsReviewed   ChangeRequest[]  @relation("ChangeRequest_reviewer")

  @@map("users")
}

// ─────────────────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────────────────

model Student {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  studentId String? @unique

  // Names (EN only, with middle name)
  titleEn       String?
  firstNameEn   String?
  middleNameEn  String?
  lastNameEn    String?

  // Personal info
  dateOfBirth DateTime?
  gender      Gender?
  nationality String?
  religion    String?
  homeCountry String?

  // Contact & address
  email               String?
  phone               String?
  addressInThailand   String?  @db.Text
  homeAddress         String?  @db.Text

  // Emergency contact
  emergencyContact  String?
  emergencyEmail    String?
  emergencyPhone    String?
  emergencyRelation String?

  // Academic info (filled by staff at Phase 2 completion)
  faculty            String?
  program            String?
  level              AcademicLevel?
  enrollmentDate     DateTime?
  expectedGraduation DateTime?
  academicStatus     String?
  scholarship        String?
  advisorId          Int?

  photoUrl           String?

  registrationStatus RegistrationStatus @default(PENDING_APPROVAL)
  registrationStep   Int                @default(0)
  rejectionReason    String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  advisor            Advisor?            @relation(fields: [advisorId], references: [id])
  passports          Passport[]
  visas              Visa[]
  healthInsurances   HealthInsurance[]
  dependents         Dependent[]
  documents          Document[]
  requests           Request[]
  visaRenewals       VisaRenewal[]
  interserviceChecks InterserviceCheck[]
  generatedDocuments GeneratedDocument[]
  academicDocuments  AcademicDocument[]
  changeRequests     ChangeRequest[]

  @@map("students")
}

// ─────────────────────────────────────────────────────
// ADVISOR
// ─────────────────────────────────────────────────────

model Advisor {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  titleEn     String?
  firstNameEn String?
  lastNameEn  String?
  nationality String?
  phone       String?

  workPermitNumber  String?
  workPermitIssue   DateTime?
  workPermitExpiry  DateTime?
  workPermitFileUrl String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  students Student[]

  @@map("advisors")
}

// ─────────────────────────────────────────────────────
// PASSPORT
// ─────────────────────────────────────────────────────

model Passport {
  id             Int      @id @default(autoincrement())
  studentId      Int      @unique
  passportNumber String
  issuingCountry String
  issueDate      DateTime
  expiryDate     DateTime
  placeOfIssue   String?
  mrzLine1       String?
  mrzLine2       String?
  imageUrl       String?
  isVerified     Boolean  @default(false)
  isCurrent      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("passports")
}

// ─────────────────────────────────────────────────────
// VISA
// ─────────────────────────────────────────────────────

model Visa {
  id             Int        @id @default(autoincrement())
  studentId      Int
  visaNumber     String?
  visaType       String
  status         VisaStatus @default(ACTIVE)
  issuingCountry String
  issuingPlace   String?
  issueDate      DateTime
  expiryDate     DateTime
  entries        String?
  remarks        String?    @db.Text
  imageUrl         String?
  arrivalImageUrl  String?
  departedImageUrl String?
  passportImageUrl String?
  isCurrent        Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("visas")
}

// ─────────────────────────────────────────────────────
// HEALTH INSURANCE
// ─────────────────────────────────────────────────────

model HealthInsurance {
  id           Int      @id @default(autoincrement())
  studentId    Int
  provider     String
  policyNumber String?
  coverageType String?
  startDate    DateTime
  expiryDate   DateTime
  fileUrl      String?
  isCurrent    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("health_insurances")
}

// ─────────────────────────────────────────────────────
// DEPENDENT
// ─────────────────────────────────────────────────────

model Dependent {
  id           Int    @id @default(autoincrement())
  studentId    Int
  relationship String

  title       String?
  firstName   String
  middleName  String?
  lastName    String
  dateOfBirth DateTime
  gender      Gender
  nationality String

  passportNumber   String?
  passportExpiry   DateTime?
  passportImageUrl String?
  visaType         String?
  visaExpiry       DateTime?
  visaImageUrl     String?
  arrivalImageUrl  String?
  departedImageUrl String?
  visaStatus       VisaStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("dependents")
}

// ─────────────────────────────────────────────────────
// DOCUMENT
// ─────────────────────────────────────────────────────

model Document {
  id           Int          @id @default(autoincrement())
  studentId    Int?
  dependentId  Int?
  documentType DocumentType @default(OTHER)
  name         String
  description  String?
  fileUrl      String
  fileType     String
  fileSize     Int
  uploadedBy   Int

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student   Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  dependent Dependent? @relation(fields: [dependentId], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ─────────────────────────────────────────────────────
// ACADEMIC DOCUMENT
// ─────────────────────────────────────────────────────

model AcademicDocument {
  id          Int      @id @default(autoincrement())
  studentId   Int
  docType     String   // Transcript, Degree Certificate, Enrollment Certificate, Other
  institution String
  issueDate   DateTime
  fileUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("academic_documents")
}

// ─────────────────────────────────────────────────────
// DOCUMENT TEMPLATE
// ─────────────────────────────────────────────────────

model DocumentTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  body        String  @db.LongText  // HTML content with {{variable}} placeholders
  variables   String? @db.Text      // JSON array of variable tokens e.g. ["{{student_name}}"]
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestTypes       RequestType[]
  generatedDocuments GeneratedDocument[]

  @@map("document_templates")
}

// ─────────────────────────────────────────────────────
// REQUEST TYPE  (staff configures)
// ─────────────────────────────────────────────────────

model RequestType {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  icon        String? // react-icons key e.g. "RiPlaneLine"
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentTemplates DocumentTemplate[]
  requests          Request[]

  @@map("request_types")
}

// ─────────────────────────────────────────────────────
// REQUEST / PETITION  (student submits)
// ─────────────────────────────────────────────────────

model Request {
  id            Int           @id @default(autoincrement())
  studentId     Int
  requestTypeId Int?
  title         String
  description   String?       @db.Text
  formData      String?       @db.LongText  // JSON — values student filled in
  status        RequestStatus @default(PENDING)
  attachments   String?       @db.Text      // JSON array of file URLs

  // Advisor review
  advisorId      Int?
  advisorComment String?   @db.Text
  advisorAt      DateTime?

  // Staff review
  staffId      Int?
  staffComment String?   @db.Text
  staffAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  requestType RequestType? @relation(fields: [requestTypeId], references: [id])

  @@map("requests")
}

// ─────────────────────────────────────────────────────
// GENERATED DOCUMENT
// ─────────────────────────────────────────────────────

model GeneratedDocument {
  id          Int     @id @default(autoincrement())
  templateId  Int
  studentId   Int
  generatedBy Int
  requestId   Int?

  fileUrl       String?
  signedFileUrl String?
  signedBy      String?
  signedAt      DateTime?
  signingMode   String?
  sigCoords     String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template   DocumentTemplate @relation(fields: [templateId], references: [id])
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  signatures DocSignature[]

  @@map("generated_documents")
}

model DocSignature {
  id           Int      @id @default(autoincrement())
  docId        Int
  role         String
  signerUserId Int
  imageUrl     String
  signedAt     DateTime @default(now())

  doc GeneratedDocument @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, role])
  @@map("doc_signatures")
}

// ─────────────────────────────────────────────────────
// EMAIL TEMPLATE
// ─────────────────────────────────────────────────────

model EmailTemplate {
  id        Int     @id @default(autoincrement())
  name      String
  subject   String
  body      String  @db.LongText
  variables String? @db.Text  // JSON
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

// ─────────────────────────────────────────────────────
// TEMPLATE VARIABLES
// ─────────────────────────────────────────────────────

model TemplateVariable {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  label       String
  description String?  @db.Text
  inputType   String   @default("auto")  // auto | text | date | textarea | select
  options     String?  @db.Text          // JSON string[] — used when inputType = 'select'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("template_variables")
}

// ─────────────────────────────────────────────────────
// VISA RENEWAL & KKU INTERSERVICE
// ─────────────────────────────────────────────────────

model VisaRenewal {
  id            Int      @id @default(autoincrement())
  studentId     Int      @unique
  daysRemaining Int
  notifiedAt    DateTime @default(now())
  isResolved    Boolean  @default(false)
  resolvedAt    DateTime?

  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  interserviceChecks InterserviceCheck[]

  @@map("visa_renewals")
}

model InterserviceCheck {
  id          Int                @id @default(autoincrement())
  studentId   Int
  renewalId   Int?
  status      InterserviceStatus @default(NOT_SUBMITTED)
  referenceId String?
  notes       String?
  checkedAt   DateTime           @default(now())

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  renewal VisaRenewal? @relation(fields: [renewalId], references: [id])

  @@map("interservice_checks")
}

// ─────────────────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────────────────

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  title     String
  message   String           @db.Text
  type      NotificationType @default(GENERAL)
  isRead    Boolean          @default(false)
  link      String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─────────────────────────────────────────────────────
// DEAN DELEGATION
// ─────────────────────────────────────────────────────

model DeanDelegation {
  id         Int      @id @default(autoincrement())
  deanId     Int      @unique
  delegateId Int
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dean     User @relation("DeanDelegation_dean",     fields: [deanId],     references: [id])
  delegate User @relation("DeanDelegation_delegate", fields: [delegateId], references: [id])

  @@map("dean_delegations")
}

// ─────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int?
  before    String?  @db.LongText
  after     String?  @db.LongText
  ipAddress String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────
// ROLE_MANAGEMENT
// ─────────────────────────────────────────────────────

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique   // "STUDENT", "ADVISOR", "STAFF", "SUB_STAFF"
  name        String                     // ชื่อแสดงผล เช่น "เจ้าหน้าที่"
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Module {
  id          Int          @id @default(autoincrement())
  code        String       @unique   // "STUDENT_MANAGEMENT"
  name        String                 // "จัดการนักศึกษา"
  parentId    Int?                   // สำหรับ sub-module (level 2)
  level       Int          @default(1)
  sortOrder   Int?
  permissions Permission[]

  @@map("modules")
}

model Permission {
  id          Int              @id @default(autoincrement())
  moduleId    Int
  method      String           // "view" | "create" | "edit" | "delete"
  code        String           @unique   // "STUDENT_MANAGEMENT.view"
  description String?
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  roles       RolePermission[]

  @@unique([moduleId, method])
  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────
// CHANGE REQUEST (student data edits pending staff approval)
// ─────────────────────────────────────────────────────

model ChangeRequest {
  id          Int       @id @default(autoincrement())
  studentId   Int
  entityType  String    // STUDENT_PROFILE | DEPENDENT | PASSPORT | VISA | HEALTH_INSURANCE | ACADEMIC_DOCUMENT
  entityId    Int?      // null for CREATE actions
  action      String    // CREATE | UPDATE | DELETE
  payload     Json
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reviewedBy  Int?
  reviewNote  String?   @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewer  User?   @relation("ChangeRequest_reviewer", fields: [reviewedBy], references: [id])

  @@map("change_requests")
}
